{
  "version": 1,
  "description": "Casos de prueba compartidos del motor de consejos. Se ejecutan en Android (JUnit) y Web (Vitest) y comparan consejos, orden y mensajes exactos.",
  "rules": {
    "effective_set": "is_warmup = 0 y dentro del rango [from_ms, to_ms]; las eliminadas las filtra la consulta",
    "progress": ">= 3 sesiones del ejercicio con 1RM y la ultima supera a la primera; valor = variacion porcentual redondeada a 1 decimal",
    "stagnation": ">= 4 sesiones del ejercicio con 1RM y |variacion| <= 0.5 %; valor = cantidad de sesiones",
    "imbalance": ">= 2 grupos con volumen y el mayor con participacion >= 50 %; valor = participacion",
    "consistency": "sesiones del periodo / (period_days / 7); >= 3 por semana es logro; < 1.5 es advertencia con la cantidad de sesiones",
    "incomplete_data": ">= 5 series efectivas y >= 30 % sin peso o sin repeticiones; valor = porcentaje",
    "order": "severidad (warning, info, success), luego kind alfabetico, luego subject alfabetico (nulo como cadena vacia)",
    "numbers": "redondeo a 1 decimal y sin decimales cuando el valor es entero"
  },
