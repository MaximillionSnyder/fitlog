  "description": "Casos de prueba compartidos del respaldo: formato, validacion y fusion por ULID. Se ejecutan en Android (JUnit) y Web (Vitest).",
  "rules": {
    "format": "format = fitlog-backup; format_version soportada = 1",
    "sections": "claves por tabla: exercise, routine, routine_exercise, session, set_entry, body_metric, app_setting",
    "merge": "upsert por clave primaria (id, o key en app_setting); gana updated_at mayor; empate conserva la fila local; deleted_at mas nuevo propaga el borrado",
    "remap": "si un ejercicio importado tiene un slug que ya existe local con otro id, no se inserta y las referencias del archivo apuntan al id local",
    "untouched": "las filas locales que no estan en el archivo no se modifican",
    "validation": "campos requeridos por tabla y referencias resueltas contra archivo + base local; cualquier fallo aborta sin efectos",
    "order": "el snapshot final se ordena por clave primaria para comparacion determinista"
  }
