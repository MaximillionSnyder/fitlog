{
  "version": 1,
  "description": "Casos de prueba compartidos de marcas personales, comparacion de periodos y balance muscular. Se ejecutan en Android (JUnit) y Web (Vitest).",
  "rules": {
    "effective_set": "is_warmup = 0; las eliminadas las filtra la consulta",
    "weight_metrics": "peso, 1RM y volumen solo consideran series con peso y repeticiones",
    "reps_metric": "la marca de repeticiones considera series con repeticiones, aunque no tengan peso",
    "ties": "en empate gana la fecha mas antigua",
    "session_volume": "volumen por ejercicio y sesion sumando peso * reps de sus series efectivas completas",
    "pr_order": "por mejor 1RM descendente, desempate por exercise_id",
    "ranges": "actual = [T - N dias, T]; anterior = [T - 2N dias, T - N dias - 1 ms]",
    "delta": "porcentaje redondeado a 1 decimal; nulo si el periodo anterior tiene 0",
    "balance": "volumen por grupo principal; los ejercicios sin grupo se agrupan en sin-grupo; orden por volumen descendente con desempate por slug",
    "share": "participacion sobre el volumen total del periodo, redondeada a 1 decimal"
  },
  "range_cases": [
    {
      "name": "30 dias",
      "preset": "30d",
      "now_ms": 1700000000000,
      "expected": {
        "current": { "from_ms": 1697408000000, "to_ms": 1700000000000 },
        "previous": { "from_ms": 1694816000000, "to_ms": 1697407999999 }
      }
    },
    {
      "name": "90 dias",
      "preset": "90d",
      "now_ms": 1700000000000,
      "expected": {
        "current": { "from_ms": 1692224000000, "to_ms": 1700000000000 },
        "previous": { "from_ms": 1684448000000, "to_ms": 1692223999999 }
      }
    }
  ],
