  "comparison_cases": [
    {
      "name": "periodo actual mejor que el anterior",
      "sets": [
        { "exercise_id": "ex-a", "session_id": "s1", "started_at_ms": 1000, "weight_kg": 100, "reps": 8, "is_warmup": 0 },
        { "exercise_id": "ex-a", "session_id": "s2", "started_at_ms": 2000, "weight_kg": 100, "reps": 8, "is_warmup": 0 },
        { "exercise_id": "ex-a", "session_id": "s2", "started_at_ms": 2000, "weight_kg": 100, "reps": 6, "is_warmup": 0 },
        { "exercise_id": "ex-a", "session_id": "s3", "started_at_ms": 3000, "weight_kg": 100, "reps": 5, "is_warmup": 0 }
